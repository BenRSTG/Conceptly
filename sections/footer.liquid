{% comment %}
  Fußzeile: Newsletter (Double-Opt-in über Shopify-Kundeneinstellung, kein
  Vorab-Häkchen), Social-Links (nur sichtbar, wenn Ben eine URL hinterlegt),
  automatische Rechtstexte-Links aus den Shopify-Richtlinien + Impressum-Seite
  (max. 1 Klick von jeder Seite), freies Footer-Menü, Zahlungssymbole.
{% endcomment %}

<footer class="footer">
  <div class="footer__top">
    <div class="footer__newsletter">
      <h2>{{ 'footer.newsletter_heading' | t }}</h2>
      <p>{{ 'footer.newsletter_text' | t }}</p>
      {% liquid
        assign newsletter_submit_label = 'footer.newsletter_submit' | t
      %}
      {% form 'customer', id: 'FooterNewsletter' %}
        {% if form.posted_successfully? %}
          <p class="footer__newsletter-success">{{ 'footer.newsletter_success' | t }}</p>
        {% else %}
          <div class="footer__newsletter-row">
            <label class="visually-hidden" for="FooterNewsletterEmail-{{ section.id }}">
              {{ 'footer.newsletter_placeholder' | t }}
            </label>
            <input
              type="email"
              name="contact[email]"
              id="FooterNewsletterEmail-{{ section.id }}"
              placeholder="{{ 'footer.newsletter_placeholder' | t }}"
              required
            >
            <input type="hidden" name="contact[tags]" value="newsletter">
            {% render 'button', content: newsletter_submit_label, type: 'submit', style: 'primary' %}
          </div>
          {% if form.errors %}
            <p class="footer__newsletter-error">{{ form.errors.messages['email'] }}</p>
          {% endif %}
        {% endif %}
      {% endform %}
    </div>

    <div class="footer__social">
      <h2 class="visually-hidden">{{ 'footer.social_heading' | t }}</h2>
      <div class="footer__social-icons">
        {% if settings.social_instagram_url != blank %}
          <a href="{{ settings.social_instagram_url }}" target="_blank" rel="noopener" class="icon-button" aria-label="Instagram">
            {{ 'icon-instagram.svg' | inline_asset_content }}
          </a>
        {% endif %}
        {% if settings.social_pinterest_url != blank %}
          <a href="{{ settings.social_pinterest_url }}" target="_blank" rel="noopener" class="icon-button" aria-label="Pinterest">
            {{ 'icon-pinterest.svg' | inline_asset_content }}
          </a>
        {% endif %}
        {% if settings.social_facebook_url != blank %}
          <a href="{{ settings.social_facebook_url }}" target="_blank" rel="noopener" class="icon-button" aria-label="Facebook">
            {{ 'icon-facebook.svg' | inline_asset_content }}
          </a>
        {% endif %}
        {% if settings.social_tiktok_url != blank %}
          <a href="{{ settings.social_tiktok_url }}" target="_blank" rel="noopener" class="icon-button" aria-label="TikTok">
            {{ 'icon-tiktok.svg' | inline_asset_content }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="footer__bottom">
    <nav class="footer__legal" aria-label="{{ 'footer.legal_heading' | t }}">
      {% for policy in shop.policies %}
        {% if policy.body != blank %}
          <a href="{{ policy.url }}">{{ policy.title }}</a>
        {% endif %}
      {% endfor %}
      {% if pages.impressum %}
        <a href="{{ pages.impressum.url }}">{{ pages.impressum.title }}</a>
      {% endif %}
    </nav>

    <div class="footer__menu">
      {% for link in section.settings.menu.links %}
        {{ link.title | link_to: link.url }}
      {% endfor %}
    </div>

    <div class="footer__payment">
      {% if section.settings.show_payment_icons %}
        {% for type in shop.enabled_payment_types %}
          {{ type | payment_type_svg_tag }}
        {% endfor %}
      {% endif %}
    </div>

    <div class="footer__copyright">
      &copy;
      {{ 'now' | date: '%Y' }}
      {{ shop.name | link_to: routes.root_url }}, {{ powered_by_link }}
    </div>
  </div>
</footer>

{% stylesheet %}
  .footer {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid currentcolor;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .footer__top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .footer__newsletter {
    max-width: 24rem;
  }

  .footer__newsletter h2 {
    font-size: 1.125rem;
    margin-bottom: 0.5rem;
  }

  .footer__newsletter-row {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .footer__newsletter-row input[type='email'] {
    flex: 1;
    border: 1px solid currentcolor;
    border-radius: var(--style-border-radius-inputs);
    padding: 0.625rem 0.875rem;
    background: transparent;
    color: var(--color-text);
  }

  .footer__social-icons {
    display: flex;
    gap: 0.5rem;
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(0 0 0 / 0.1);
  }

  .footer__legal,
  .footer__menu {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer__legal a,
  .footer__menu a {
    text-decoration: none;
    color: var(--color-text);
    font-size: 0.875rem;
    opacity: 0.8;
  }

  .footer__payment {
    display: flex;
    gap: 0.5rem;
    margin-inline-start: auto;
  }

  .footer__copyright {
    width: 100%;
    font-size: 0.75rem;
    opacity: 0.6;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    }
  ]
}
{% endschema %}
