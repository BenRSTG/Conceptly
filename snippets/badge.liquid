{% doc %}
  Renders a small text badge/label, e.g. "Neu" or "Handgefertigt".

  @param {string} text - Badge text
  @param {string} [style] - Visual style: 'neutral' (default), 'accent' (Sand), 'dark' (Anthrazit)

  @example
  {% render 'badge', text: 'Neu' %}
  {% render 'badge', text: 'Handgefertigt', style: 'accent' %}
{% enddoc %}

{% liquid
  assign style = style | default: 'neutral'
%}

<span class="badge badge--{{ style }}">{{ text }}</span>

{% stylesheet %}
  .badge {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .badge--neutral {
    background: var(--color-background);
    color: var(--color-text);
    border: 1px solid var(--color-text);
  }

  /* Stand: Markenfarben Sand/Anthrazit, Quelle: DECISIONS.md */
  .badge--accent {
    background: #e4d6bf;
    color: #313139;
  }

  .badge--dark {
    background: #313139;
    color: #faf8f5;
  }
{% endstylesheet %}
